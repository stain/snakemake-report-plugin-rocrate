# pixi environments
.pixi/*
!.pixi/config.toml

# Builds
dist/

# pytest / coverage
.coverage
coverage-report/
.pytest_cache/

# Python bytecode
__pycache__/
*.pyc

# VSCode
.vscode/*
# Snakemake working state in the examples; keep the job metadata the
# reporter reads, ignore created conda envs, logs and locks
**/.snakemake/*
!**/.snakemake/metadata/
